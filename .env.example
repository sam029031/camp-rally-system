# ---- Supabase（前端只用這兩個做讀取與 Realtime）----
# 後台 Project Settings → API（新版：Settings → API Keys）
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
# 新版填 Publishable key（sb_publishable_…）；舊版填 legacy anon key
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# ---- 只在 server / scripts 使用，絕對不要加 NEXT_PUBLIC_ 前綴 ----
# 新版填 Secret key（sb_secret_…）；舊版填 legacy service_role key
SUPABASE_SERVICE_ROLE_KEY=

# cookie session 簽章用（至少 32 字元的隨機字串，例如 openssl rand -base64 48）
SESSION_SECRET=

# 初始總召 PIN（6 位數字；import 時建立 ADMIN 身分）
INITIAL_ADMIN_PIN=

# 活動日期（只當 import 第一次建立活動時的預設值，之後在 /admin 修改）
EVENT_DATE=2026-10-17

# development | demo | production（未設定視同 production：不允許 Demo 與 Reset）
APP_ENV=development

# ---- DB 測試專用（不可與上面的正式 project 相同；沒設定就 skip DB 測試）----
# 本機：npx supabase start 後，用 npx supabase status 顯示的 API URL 與 service_role / secret key
SUPABASE_TEST_URL=
SUPABASE_TEST_SERVICE_ROLE_KEY=
